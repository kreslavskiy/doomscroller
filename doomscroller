#!/bin/bash
# doomscroller: while Claude Code is working, show Reels or Shorts in the browser;
# when it stops (idle or waiting for you), pause the video and bring Claude
# back to the front.
#
# Reads ~/.doomscroller/claude-status, kept by hooks/session-status.sh.
# Commands, flags and settings: run doomscroller --help.
# How the code is laid out: CLAUDE.md.

# This command, as it was run. The background watcher re-runs it.
DOOMSCROLLER="$0"

# The installed command is usually a symlink to this file: follow it to lib/.
self="$0"
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(dirname "$self")/$link" ;;
  esac
done
LIB_DIR="$(cd "$(dirname "$self")" && pwd)/lib"

for module in core settings sites claude macos browser player watcher cli; do
  source "$LIB_DIR/$module.sh"
done

load_settings
main "$@"
